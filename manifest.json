{
  "manifest_version": 3,
  "name": "Instagram Auto-Scroll",
  "version": "1.3.0",
  "description": "Auto-advances Instagram Reels. Only active on instagram.com/reels.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Instagram Auto-Scroll",
    "default_popup": "popup.html"
  }
}
