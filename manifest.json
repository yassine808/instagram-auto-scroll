{
  "manifest_version": 3,
  "name": "Instagram Auto-Scroll",
  "version": "1.1.0",
  "description": "Auto-advances Instagram Reels. Toggle on the page or from the extension settings.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_title": "Instagram Auto-Scroll",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
